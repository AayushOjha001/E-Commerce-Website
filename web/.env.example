# Copy to web/.env.local and fill in. Never commit real values.
# .gitignore tracks this example file only (`.env*` is ignored, `!.env.example` re-included).

# Local dev MongoDB. Matches docker-compose.yml at the repo root, which maps
# host 27018 -> container 27017. Start it with: docker compose up -d mongo
MONGODB_URI=mongodb://localhost:27018/ecommerce_dev

# Secret used to sign session JWTs. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_value_at_least_32_chars

# Optional. Defaults to development when unset.
# NODE_ENV=development
