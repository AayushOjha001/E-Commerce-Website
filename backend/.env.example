# Copy to backend/.env and fill in. Never commit the real .env (it is gitignored).
#
# This is the LEGACY Express backend. It stays runnable until the Batch 7 cutover;
# new work happens in web/ (see web/.env.example).

# Port the Express server listens on.
PORT=5000

# Local dev MongoDB. Matches docker-compose.yml, which maps host 27018 -> container 27017.
# Start it with: docker compose up -d mongo
MONGO_URI=mongodb://localhost:27018/ecommerce_dev

# Secret used to sign JWTs. Use a long random value; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
